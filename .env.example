# Salin file ini jadi .env lalu isi nilainya.
# Jangan commit .env. Di GitHub Actions, isi nilai yang sama lewat Secrets dan Variables.

# youtube_only = kanal ini tidak menerbitkan ke TikTok atau platform lain.
# Telegram tetap boleh dipakai untuk notifikasi.
PLATFORM_MODE=youtube_only
CHANNEL_NAME=AI WHAT IF?
YT_CHANNEL_NAME=AI WHAT IF?

# free_safe | auto_fallback | local_only
# free_safe: Gemini, lalu Groq kalau ada kunci, lalu template lokal. Gambar Cloudflare, lalu aset lokal. Suara Edge TTS.
# auto_fallback: rantai cadangan yang dinyalakan eksplisit. Layanan berbayar tetap mati selama FREE_ONLY=true.
# local_only: tidak memanggil API untuk konten baru. Butuh --naskah beserta gambar dan audio yang sudah ada.
PROVIDER_MODE=free_safe
FREE_ONLY=true
PAID_FALLBACK_ENABLED=false

# Naskah. Groq hanya dicoba kalau GROQ_API_KEY terisi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_CADANGAN=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
SCRIPT_PROVIDER=gemini
SCRIPT_FALLBACK_PROVIDER=groq
SCRIPT_LOCAL_FALLBACK=true
TEXT_FALLBACK_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Suara Indonesia: id-ID-ArdiNeural (pria) atau id-ID-GadisNeural (wanita)
TTS_PROVIDER=edge_tts
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+5%
TTS_FALLBACK_PROVIDER=local_audio
TTS_FALLBACK_ENABLED=true

# Gambar. Cloudflare adalah provider utama.
# Perkiraan neuron bisa berubah; jangan menganggap kuota gratis selalu sama.
# flux-2-klein-9b lebih boros dan hanya untuk gambar hook. flux-1-schnell untuk adegan lain.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b,@cf/black-forest-labs/flux-1-schnell
CF_IMAGE_MODEL_HEMAT=@cf/black-forest-labs/flux-1-schnell
IMAGE_PROVIDER=cloudflare
IMAGE_FALLBACK_PROVIDER=local_assets
IMAGE_LOCAL_FALLBACK=true
IMAGE_PER_VIDEO=4
IMAGE_DAILY_MAX=20
# AI Horde hanya jalan di PROVIDER_MODE=auto_fallback dan HORDE_ENABLED=true.
# Antreannya bisa lama dan kuotanya tidak dijamin.
HORDE_ENABLED=false
HORDE_API_KEY=0000000000
HORDE_MODELS=AlbedoBase XL (SDXL),AlbedoBase XL 3.1,Juggernaut XL
HORDE_MAX_WAIT_DETIK=900
# fal.ai berbayar. Tidak dipanggil kalau FREE_ONLY=true.
# Untuk mengizinkannya, semua syarat ini harus hidup sekaligus:
# FREE_ONLY=false, PAID_FALLBACK_ENABLED=true, PROVIDER_MODE=auto_fallback,
# IMAGE_FALLBACK_ENABLED=true, FAL_KEY terisi, dan batas biaya terisi.
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell
IMAGE_FALLBACK_ENABLED=false
IMAGE_FALLBACK_MAX_COST_USD_PER_JOB=

MAX_VIDEO_HARIAN=5
MAX_RETRY=2
DURASI_MIN=35
DURASI_MAX=55

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upload mati secara default. Uji pertama harus private.
YT_UPLOAD=0
YT_PRIVACY=private
