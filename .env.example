# Salin file ini jadi .env lalu isi nilainya.
# Kalau jalan di GitHub Actions, nilai yang sama diisi di Settings > Secrets and variables > Actions.

# API key gratis dari https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Dicoba berurutan kalau model utama sedang penuh atau kena limit
GEMINI_MODEL_CADANGAN=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Cadangan naskah. Kosongkan GROQ_API_KEY untuk menonaktifkan Groq.
# GROQ_MODEL default mengikuti contoh resmi Groq: llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TEXT_FALLBACK_ENABLED=true

CHANNEL_NAME=KerjaPakaiAI

# Suara Indonesia: id-ID-ArdiNeural (pria) atau id-ID-GadisNeural (wanita)
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+8%

# Gambar AI gratis dari Cloudflare Workers AI (lihat README)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Dicoba berurutan, pisahkan dengan koma. CF_IMAGE_MODEL untuk gambar hook (kualitas),
# CF_IMAGE_MODEL_HEMAT untuk 3 adegan lain. Kuota gratis 10.000 neuron/hari:
# flux-2-klein-9b ~1.000 neuron/gambar, flux-1-schnell ~100 neuron/gambar.
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b,@cf/black-forest-labs/flux-1-schnell
CF_IMAGE_MODEL_HEMAT=@cf/black-forest-labs/flux-1-schnell
# fal.ai hanya jalan kalau IMAGE_FALLBACK_ENABLED=true, FAL_KEY terisi,
# dan estimasi biaya tidak melewati batas. Default mati.
# Harga yang dikenali: fal-ai/flux/schnell = $0.003 per megapiksel, dibulatkan ke atas.
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell
IMAGE_FALLBACK_ENABLED=false
IMAGE_FALLBACK_MAX_COST_USD_PER_JOB=

# Bot Telegram untuk menerima video (lihat README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 = upload otomatis ke YouTube setelah video jadi
YT_UPLOAD=0
# private, unlisted, atau public
YT_PRIVACY=private
